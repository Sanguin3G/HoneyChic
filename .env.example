TZ=UTC
NODE_ENV=development
PORT=3333
HOST=127.0.0.1
LOG_LEVEL=info
APP_KEY=
APP_URL=http://localhost:3333
SESSION_DRIVER=cookie

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=honeychic
DB_PASSWORD=honeychic_local
DB_DATABASE=honeychic
DB_SSL=false

STORE_NAME=Demo Supply
STORE_DEFAULT_LOCALE=en
STORE_CURRENCY=VND
STORE_TIMEZONE=Asia/Ho_Chi_Minh

# Order and account mail. Mailpit accepts the local sender below.
# Delivery is skipped when SMTP_HOST is empty, or when both the store contact email and MAIL_FROM_ADDRESS are empty.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=store@localhost
MAIL_FROM_NAME=Demo Supply
LIMITER_STORE=database

# Local previews remain noindex regardless of this value.
SEO_INDEXABLE=false

# fs keeps uploads in public/media and serves them at /media. s3 is unused until a bucket exists.
DRIVE_DISK=fs
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
