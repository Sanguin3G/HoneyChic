TZ=UTC
NODE_ENV=production
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=info
# Generate a separate runtime key; this file contains no credentials.
APP_KEY=
APP_URL=https://shop.example.com
# Proxy address(es)/CIDRs allowed to set forwarded headers. Required behind a TLS-terminating proxy.
TRUSTED_PROXIES=
SESSION_DRIVER=cookie
LIMITER_STORE=database
DB_HOST=postgres
DB_PORT=5432
DB_USER=honeychic
DB_PASSWORD=
DB_DATABASE=honeychic
DB_SSL=false
STORE_NAME=My Store
STORE_DEFAULT_LOCALE=en
STORE_CURRENCY=VND
STORE_TIMEZONE=Asia/Ho_Chi_Minh
# Enable only on the public production origin after launch review.
SEO_INDEXABLE=false
# SMTP delivery. Leave SMTP_HOST empty to skip mail. Authenticate only when the provider requires it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
# fs stores merchant uploads on the container disk, which is ephemeral. Use s3 before a hosted launch.
# Required with DRIVE_DISK=s3: S3_REGION, S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, S3_PUBLIC_URL.
# S3_ENDPOINT is only for an S3-compatible host. S3_PUBLIC_URL is the browser base, without a trailing file name.
DRIVE_DISK=fs
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
